#!/bin/sh
# Resume this tool's paused rebase when a resolver stages the final conflict.
set -eu
test "${SEMVER_ENGINE_ACTIVE:-}" != 1 || exit 0
test -z "${GIT_INDEX_FILE:-}" || exit 0
# Reuse Git's directory when supplied; discover it for other invocations.
gitdir=${GIT_DIR:-$(git rev-parse --absolute-git-dir)}
state=$gitdir/semver-release
test -f "$state/engine" && test -f "$state/phase" || exit 0
test "$(cat "$state/phase")" = rebase || exit 0
test ! -d "$gitdir/semver-command-lock" || exit 0
sh "$state/engine" --auto-continue
